programa {
  funcao inicio() { /* pedir um número ao usuário e mostrar a tabuada dele*/

  inteiro num
  inteiro contador
    escreva( " quer a tabuada de qual numero? ")
    leia(num) 
    para ( inteiro contador = 1; contador <= 10; contador++)
    escreva(num, " x ", contador, " = ",num * contador, "\n")





  }
}
